fn funca(a: *i32): i32 =>
	let b: i32 = *a
	return b + 2

fn funcb(a: *i32?): i32 =>
	if a == null =>
		return 1
	let b: i32 = *a
	return b

fn funcc(a: *i32?): *i32? =>
	return null

fn funcd(a: *i32?): *i32? =>
	return a

pub fn main: i32 =>
	let mut a: i32 = 1
	let mut b: *i32? = &a
	let c: *i32 = funcc b
	|? => return 1
	return 0
