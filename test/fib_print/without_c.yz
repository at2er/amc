@syscall[1]
fn write(fd: u32,
	buf: [char],
	count: u64): u64

fn print_int(i: i32): i32 =>
	let mut x: i32 = i
	let mut idx: i32 = 0
	let mut arr: [i32, 8] = { 0, 0, 0, 0, 0, 0, 0, 0 }
	while x > 0 =>
		let q: i32 = x / 10
		let r: i32 = x - 10 * q
		arr[idx] = r + 48
		idx += 1
		x = q
	write 1, arr, 8
	ret 0

fn rec fib(n: i32): i32 =>
	if n <= 1 =>
		ret n
	ret (fib (n - 1)) + (fib (n - 2))

pub fn main: i32 =>
	let a: i32 = fib 35
	ret print_int a
